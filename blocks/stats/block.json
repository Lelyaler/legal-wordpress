{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "legal/stats",
  "version": "1.0.0",
  "title": "Legal Trust Statistics",
  "category": "legal-blocks",
  "icon": "chart-bar",
  "description": "Grid of key trust figures and statistics (years of practice, cases won, saved client capital).",
  "keywords": [ "legal", "stats", "counter", "trust", "numbers" ],
  "textdomain": "legal-wordpress",
  "supports": {
    "html": false,
    "align": [ "wide", "full" ]
  },
  "attributes": {
    "num1": {
      "type": "string",
      "default": "14+"
    },
    "label1": {
      "type": "string",
      "default": "Лет юридической практики"
    },
    "desc1": {
      "type": "string",
      "default": "Успешно защищаем интересы доверителей с 2012 года"
    },
    "num2": {
      "type": "string",
      "default": "98.4%"
    },
    "label2": {
      "type": "string",
      "default": "Выигранных дел в судах"
    },
    "desc2": {
      "type": "string",
      "default": "Достигаем поставленных целей на любой стадии процесса"
    },
    "num3": {
      "type": "string",
      "default": "2.8 млрд ₽"
    },
    "label3": {
      "type": "string",
      "default": "Сохраненных активов"
    },
    "desc3": {
      "type": "string",
      "default": "Предотвратили финансовые потери клиентов по всей РФ"
    },
    "num4": {
      "type": "string",
      "default": "3 500+"
    },
    "label4": {
      "type": "string",
      "default": "Успешных соглашений"
    },
    "desc4": {
      "type": "string",
      "default": "Доверие физических лиц и ведущих предприятий"
    }
  },
  "editorScript": "legal-editor-blocks",
  "render": "file:./render.php"
}
